<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Poké‑Center</title>

  <!-- Single consolidated stylesheet -->
  ./css/styles.css
</head>

<body>

  <!-- MAIN HEADER (HOME ONLY) -->
  <div id="main-header">

    <div class="main-title">
      ./assets/logos/Poke_Center.png
      <h1 class="title">Poké‑Center</h1>
    </div>

    <button id="my-pokedex-button" class="pokedex-button">
      ./assets/logos/pokedex.png
      My Pokedex
    </button>

    <h2 class="subtitle">Select a Collection</h2>

  </div>

  <!-- COLLECTION SELECTOR SCREEN -->
  <div id="collection-selector" class="collection-selector"></div>

  <!-- COLLECTION OVERVIEW SCREEN -->
  <div id="collection-overview" class="collection-overview hidden">

    <!-- Header -->
    <div class="overview-header">

      <div>
        <button id="overview-back-button" class="return-button">
          Return to Poké‑Center
          ./assets/logos/Poke_Center.png
        </button>
      </div>

      <div>
        <button id="overview-pokedex-button" class="pokedex-button">
          My Pokedex
          ./assets/logos/pokedex.png
        </button>
      </div>

    </div>

    <!-- Collection Title -->
    <h2 id="overview-title" class="overview-title"></h2>

    <!-- Collection Logo -->
    <img id="overview-logo" class="overview-logo">

    <!-- Stats Subtitle -->
    <h2 id="overview-stats-title" class="subtitle"></h2>

    <!-- Collection Stats -->
    <div id="overview-progress" class="overview-progress">

      <p id="overview-total"></p>

      <div class="overview-rarity-row">
        <span class="rarity-icon" id="rarity-common-icon"></span>
        <span class="rarity-label">Common</span>

        <div class="rarity-bar">
          <div id="rarity-common-fill" class="rarity-fill"></div>
        </div>

        <span id="rarity-common-text" class="rarity-text"></span>
      </div>

      <div class="overview-rarity-row">
        <span class="rarity-icon" id="rarity-uncommon-icon"></span>
        <span class="rarity-label">Uncommon</span>

        <div class="rarity-bar">
          <div id="rarity-uncommon-fill" class="rarity-fill"></div>
        </div>

        <span id="rarity-uncommon-text" class="rarity-text"></span>
      </div>

      <div class="overview-rarity-row">
        <span class="rarity-icon" id="rarity-rare-icon"></span>
        <span class="rarity-label">Rare</span>

        <div class="rarity-bar">
          <div id="rarity-rare-fill" class="rarity-fill"></div>
        </div>

        <span id="rarity-rare-text" class="rarity-text"></span>
      </div>

    </div>

    <!-- Catch Subtitle -->
    <h2 id="overview-catch-title" class="subtitle"></h2>

    <!-- Catch Button -->
    <div class="catch-images">
      ./assets/logos/catch_open.png
    </div>

  </div>

  <!-- CARD VIEWER -->
  <div id="card-viewer" class="card-viewer hidden">

    <button id="viewer-back-button" class="return-button">
      Return to Collection
    </button>

    <h2 id="collection-title"></h2>

    <button id="viewer-pokedex-button" class="pokedex-button">
      ./assets/logos/pokedex.png
      My Pokedex
    </button>

    <div id="card-grid" class="card-grid"></div>

    <button id="reset-pokedex-button" class="reset-button">
      Reset My Pokedex
    </button>

  </div>

  <!-- MY POKEDEX -->
  <div id="pokedex" class="pokedex hidden">

    <button id="mc-back-button" class="return-button">
      ./assets/logos/Poke_Center.png
      Return to Poké‑Center
    </button>

    <h2>My Pokedex</h2>

    <div id="pokedex-grid" class="pokedex-grid"></div>

  </div>

  <!-- CARD MODAL -->
  <div id="card-modal" class="card-modal hidden">

    <div class="card-modal-content">

      <button id="modal-close" class="modal-close-btn">
        ✖
      </button>

      <img id="modal-image">

      <h3 id="modal-name"></h3>

      <!-- Modal keeps original rarity-row -->
      <div id="modal-rarity" class="rarity-row">
        <span id="modal-rarity-icon"></span>
        <span id="modal-rarity-text"></span>
      </div>

    </div>

  </div>

  <!-- JavaScript -->
  ./js/collection-selector.jsscript>

</body>
</html>
